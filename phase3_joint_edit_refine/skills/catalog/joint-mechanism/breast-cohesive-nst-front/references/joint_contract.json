      "minimum_anchor_coverage_fraction": 0.55,
      "requires_new_target_cells": true
    },
    "required_checker_ids": ["whole_instance_changes", "protected_nuclei_preserved", "nuclei_overlap", "nuclei_tissue_containment", "cell_quota", "cell_spatial_distribution"]
  },
  "coupling_contract": {
    "compatibility_rule_ids": ["breast.joint.cohesive_front_population", "breast.joint.protect_benign_in_situ_vessel"],
    "allow_neoplastic_in_non_tumor_tissue": false,
    "joint_area_mode": "joint_footprint",
    "tissue_floor_applies": true,
    "cell_only_target_fraction": 0.0,
