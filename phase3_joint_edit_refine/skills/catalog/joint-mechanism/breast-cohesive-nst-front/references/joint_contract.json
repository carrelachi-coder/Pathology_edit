        "source_labels": ["Stroma", "Other tissue"],
        "target_labels": ["Tumor"]
      },
      "tumor-burden-decrease-v1": {
        "source_labels": ["Tumor"],
        "target_labels": ["Stroma", "Other tissue"]
      },
      "stroma-increase-v1": {
        "source_labels": ["Tumor"],
        "target_labels": ["Stroma"]
      }
    },
    "allowed_tools": ["interface_band_sdf", "topology_safe_morphology", "organic_v2"],
    "required_checker_ids": ["tissue_gate_binding", "native_structure_preserved"],
    "prohibited_structures": ["benign_duct", "benign_lobule", "dcis_unit", "vessel", "necrosis"]
  },
  "cell_program": {
