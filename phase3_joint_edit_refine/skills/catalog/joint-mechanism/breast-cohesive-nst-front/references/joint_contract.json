    "veto_findings": ["invented single-file invasion", "partial benign duct or lobule", "rectangular tumor fill", "lost vessel or DCIS unit"],
    "mask_guarantees": ["paired tissue/nuclei condition", "complete-instance preservation outside joint support"],
